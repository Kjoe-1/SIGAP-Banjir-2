# ============================================================
# SIGAP Banjir - Contoh konfigurasi environment.
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# --- Telegram ---
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_default_chat_id

# --- MySQL (server sensor) ---
DB_HOST=your_mysql_host
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_PORT=3306

# --- Database sensor per-lokasi (HANYA DIBACA) ---
DB_LOK1=dbpvwemon
DB_LOK2=dbpvwemonbaru
DB_LOK3=dbpvwemonbaru2

# --- Database bot (tabel User & Preference) ---
DB_BOT=sigap_bot

# URL koneksi async database bot (SQLAlchemy).
# SQLite lokal (default aman):
BOT_DB_URL=sqlite+aiosqlite:///./sigap_bot.db
# MySQL (kalau sudah ada izin):
# BOT_DB_URL=mysql+aiomysql://your_user:your_password@your_host:3306/sigap_bot

# --- Pengaturan scheduler ---
MODE_PREDIKSI=demo     # 'demo' (CSV statis) atau 'db' (sensor MySQL realtime)
INTERVAL_MENIT=60      # interval cek prediksi (menit)
